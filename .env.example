# Копировать в .env.local / .env.dev / .env.prod — сами файлы в .gitignore, не коммитить.
# На dev/prod сервере эти значения приходят из GitHub Secrets в CI, .env генерируется при деплое.

ASPNETCORE_ENVIRONMENT=Development

# --- База данных ---
POSTGRES_DB=gameorg_local
POSTGRES_USER=gameorg
POSTGRES_PASSWORD=change_me
# Полная строка, которую использует API (ConnectionStrings__Default через двойное подчёркивание):
ConnectionStrings__Default=Host=localhost;Port=5433;Database=gameorg_local;Username=gameorg;Password=change_me

# --- Auth ---
JWT_SIGNING_KEY=change_me_min_32_chars_random
TELEGRAM_BOT_TOKEN=

# --- Медиа (Cloudflare R2, отдельный бакет от бэкапов — см. docs/PLAN.md §11) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=game-org-media
R2_ENDPOINT=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:5100
