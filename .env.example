# Копировать в .env.local / .env.dev / .env.prod — сами файлы в .gitignore, не коммитить.
# На dev/prod сервере эти значения приходят из GitHub Secrets в CI, .env генерируется при деплое.

ASPNETCORE_ENVIRONMENT=Development

# --- База данных ---
POSTGRES_DB=gameorg_local
POSTGRES_USER=gameorg
POSTGRES_PASSWORD=change_me
# Полная строка, которую использует API (ConnectionStrings__Default через двойное подчёркивание):
ConnectionStrings__Default=Host=localhost;Port=5434;Database=gameorg_local;Username=gameorg;Password=change_me

# --- Auth ---
JWT_SIGNING_KEY=change_me_min_32_chars_random
TELEGRAM_BOT_TOKEN=
# telegram_id через запятую — эти аккаунты становятся Admin при логине
# (IdentityService.PromoteToAdminIfListed, docs/PLAN.md §9). Проверяется при
# каждом входе, не только при регистрации — значит подействует и на уже
# существующий аккаунт.
ADMIN_TELEGRAM_IDS=

# --- Медиа (Cloudflare R2, отдельный бакет от бэкапов — см. docs/PLAN.md §11) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=game-org-media
R2_ENDPOINT=
# Публичный URL для раздачи (r2.dev или кастомный поддомен) — им отдаются фото площадок
R2_PUBLIC_URL=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:5100
# @username бота для Telegram Login Widget (без @), см. data-telegram-login в /login
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Публичный домен сайта — нужен только для metadataBase (hreflang/OG в [locale]/[handle]/page.tsx)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
